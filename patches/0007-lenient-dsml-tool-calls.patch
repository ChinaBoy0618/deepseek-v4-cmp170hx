+# Lenient envelope variants: the Flash checkpoint occasionally emits a
+# leading underscore in the tool-calls envelope when output degrades in
+# long contexts (observed "<｜DSML｜_tool_calls>" with a
+# well-formed invoke/parameter body inside; the official encoding README
+# states parsers do not recover malformed output). These aliases keep
+# such calls parseable instead of leaking them as plain content.
+DSML_TOOL_START_LENIENT = f"<{_DSML}_tool_calls>"
+DSML_TOOL_END_LENIENT = f"</{_DSML}_tool_calls>"
+
