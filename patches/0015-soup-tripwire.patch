+    def _dsv4_soup_count(self, request: Request) -> int:
+        """DSV4 0015: number of signature occurrences in the decoded
+        24-token tail. First-token prefilter keeps the common case at a
+        24-element id scan with no tokenizer call."""
+        _tail_ids = request._output_token_ids[-24:]
+        if not any(_t in self._dsv4_sig_first_ids for _t in _tail_ids):
+            return 0
+        _tok = getattr(self.structured_output_manager, "tokenizer", None)
+        if _tok is None:
+            return 0
+        _tail = _tok.decode(_tail_ids)
+        return sum(_tail.count(_s) for _s in self._DSV4_SIG_STRINGS)
+
