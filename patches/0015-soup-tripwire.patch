+    def _dsv4_soup_tags(self, request: Request, new_token_ids) -> set:
+        """DSV4 0015 v3: which signatures appear in the tokens appended
+        THIS block plus a 16-token overlap. A tag only counts while new
+        tokens keep arriving around it -- a legit tag parked at the end
+        of the output stops counting immediately, while soup keeps
+        producing tags every block. First-token prefilter keeps the
+        common case at an id scan with no tokenizer call."""
+        _win = request._output_token_ids[-(len(new_token_ids) + 16):]
+        if not any(_t in self._dsv4_sig_first_ids for _t in _win):
+            return set()
+        _tok = getattr(self.structured_output_manager, "tokenizer", None)
+        if _tok is None:
+            return set()
+        _txt = _tok.decode(_win)
+        return {_s for _s in self._DSV4_SIG_STRINGS if _s in _txt}
