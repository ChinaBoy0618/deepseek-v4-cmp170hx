+def _dsv4_0022_flags(text: str, finish_reason: str | None) -> list[str] | None:
+    """Classify a tools-request response body that emitted no tool call."""
+    if any(s in text for s in _DSV4_0022_SIGS):
+        return ["pseudo_tag"]
+    if finish_reason == "length":
+        return ["budget_burn"]
+    return None
 
 
