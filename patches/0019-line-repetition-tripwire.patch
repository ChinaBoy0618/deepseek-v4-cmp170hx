+    _DSV4_REP_WHITELIST = frozenset({
+        "---", "===", "***", "___", "--", "==", "```", "---...",
+    })
+
+    def _dsv4_rep_lines(self, request: Request, new_token_ids) -> "str | None":
+        """DSV4 0019: the short line repeated >=5x in this block's decode
+        window, or None. Char-length prefilter (<=28) keeps the encode
+        check rare; separators whitelisted; long lines never flagged."""
+        _tok = getattr(self.structured_output_manager, "tokenizer", None)
+        if _tok is None:
+            return None
+        _win = request._output_token_ids[-(len(new_token_ids) + 16):]
+        if not _win:
+            return None
+        _txt = _tok.decode(_win)
+        _counts: dict[str, int] = {}
+        for _ln in _txt.splitlines():
+            _ln = _ln.strip()
+            if not _ln or len(_ln) > 28 or _ln in self._DSV4_REP_WHITELIST:
+                continue
+            _counts[_ln] = _counts.get(_ln, 0) + 1
+        for _ln, _n in _counts.items():
+            if _n >= 5 and len(_tok.encode(_ln, add_special_tokens=False)) <= 6:
+                return _ln
+        return None
+
