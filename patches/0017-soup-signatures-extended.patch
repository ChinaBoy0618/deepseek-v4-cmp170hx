+    def _dsv4_clean_cut(self, out_tail, decode, max_back: int = 16) -> int:
+        """DSV4 0017 P0-b: how many trailing tokens to drop so the visible
+        text does not end inside a half-written tag fragment. Fires only
+        when the decoded tail ends in an unclosed '<' + tagname run (no
+        '>' after the last '<', tagname starts alpha or '/'), so 'a < b'
+        math/prose never triggers. Bounded by max_back tokens."""
+        n = len(out_tail)
+        if n == 0:
+            return 0
+        txt = decode(out_tail[-min(n, 64):])
+        lt = txt.rfind("<")
+        if lt < 0:
+            return 0
+        after = txt[lt + 1:]
+        if not after:
+            return min(1, max_back)  # bare trailing '<'
+        if ">" in after:
+            return 0  # tag closed -> clean boundary
+        first = after[0]
+        if not (first.isalpha() or first == "/"):
+            return 0  # '< ' + space == not a tag start
+        if len(after) > 64:
+            return 0  # implausible fragment, leave it
+        need = len(txt) - lt  # chars from '<' to end of tail
+        for k in range(1, min(max_back, n) + 1):
+            if len(decode(out_tail[-k:])) >= need:
+                return k
+        return min(max_back, n)
+
