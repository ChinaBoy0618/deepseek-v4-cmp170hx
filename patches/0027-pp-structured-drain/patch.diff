+) -> None:
+    # DSv4-0027: port of buliaoyin 6e959b2 / vllm#45015 — merge the drained
+    # batches' outputs into the step's result.
+    for client_index, out in src.items():
+        cur = dst.get(client_index)
+        if cur is None:
+            dst[client_index] = out
